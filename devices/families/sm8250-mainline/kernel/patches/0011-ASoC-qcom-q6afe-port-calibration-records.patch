+++ b/sound/soc/qcom/qdsp6/q6afe-dai.c	2026-11-02 16:44:51.558171760 +0000
@@ -9,6 +9,7 @@
 #include <linux/device.h>
 #include <linux/platform_device.h>
 #include <linux/slab.h>
+#include <linux/firmware.h>
 #include <sound/pcm.h>
 #include <sound/soc.h>
 #include <sound/pcm_params.h>
@@ -29,6 +30,9 @@
 	uint32_t data_delay;
 	uint32_t data_align;
 	uint32_t topology;
+	/* Module parameters sent at port start, see q6afe_port_set_cal() */
+	const char *cal_firmware;
+	bool cal_loaded;
 	/* Feedback (e.g. speaker V/I sense) TX port started with this RX port */
 	int feedback_dai;
 	uint32_t feedback_chans[Q6AFE_MAX_FEEDBACK_CHANNELS];
@@ -66,6 +70,36 @@
 	dai_data->custom_topologies_registered = true;
 }
 
+static void q6afe_dai_load_cal(struct device *dev,
+			       struct q6afe_dai_data *dai_data, int id)
+{
+	struct q6afe_dai_priv_data *priv = &dai_data->priv[id];
+	const struct firmware *fw;
+	void *cal;
+	int ret;
+
+	if (!priv->cal_firmware || priv->cal_loaded)
+		return;
+	/* Only try once: without it the modules run on their defaults. */
+	priv->cal_loaded = true;
+
+	ret = request_firmware(&fw, priv->cal_firmware, dev);
+	if (ret) {
+		dev_err(dev, "dai %d: no calibration %s (%d)\n", id,
+			priv->cal_firmware, ret);
+		return;
+	}
+
+	cal = devm_kmemdup(dev, fw->data, fw->size, GFP_KERNEL);
+	if (cal) {
+		ret = q6afe_port_set_cal(dai_data->port[id], cal, fw->size);
+		if (ret)
+			dev_err(dev, "dai %d: bad calibration %s\n", id,
+				priv->cal_firmware);
+	}
+	release_firmware(fw);
+}
+
 /*
  * Run the feedback TX port of an RX port, the way the vendor stacks do with
  * a hostless capture: feedback path set, RX started, then TX started with
@@ -111,6 +145,7 @@
 
 	*cfg = dai_data->port_config[rx_id].i2s_cfg;
 	cfg->sd_line_mask = dai_data->priv[tx_id].sd_line_mask;
+	q6afe_dai_load_cal(dev, dai_data, tx_id);
 
 	ret = q6afe_i2s_port_prepare(dai_data->port[tx_id], cfg);
 	if (!ret)
@@ -546,6 +581,7 @@
 
 	if (dai_data->priv[dai->id].topology)
 		q6afe_dai_register_topologies(dai->dev, dai_data);
+	q6afe_dai_load_cal(dai->dev, dai_data, dai->id);
 
 	if (dai_data->priv[dai->id].feedback_dai >= 0)
 		q6afe_dai_feedback_set_path(dai->dev, dai_data, dai->id);
@@ -1177,6 +1213,8 @@
 
 		priv = &data->priv[id];
 		of_property_read_u32(node, "qcom,topology", &priv->topology);
+		of_property_read_string(node, "qcom,cal-firmware",
+					&priv->cal_firmware);
 		if (!of_property_read_u32(node, "qcom,feedback-dai", &fb) &&
 		    fb < AFE_PORT_MAX && fb != id) {
 			ret = of_property_read_variable_u32_array(node,
