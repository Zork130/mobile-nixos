@@ -14,8 +14,11 @@
 #include <sound/pcm_params.h>
 #include "q6dsp-lpass-ports.h"
 #include "q6dsp-common.h"
+#include "q6core.h"
 #include "q6afe.h"
 
+#define Q6AFE_MAX_FEEDBACK_CHANNELS	4
+
 
 struct q6afe_dai_priv_data {
 	uint32_t sd_line_mask;
@@ -25,6 +28,11 @@
 	uint32_t invert_sync;
 	uint32_t data_delay;
 	uint32_t data_align;
+	uint32_t topology;
+	/* Feedback (e.g. speaker V/I sense) TX port started with this RX port */
+	int feedback_dai;
+	uint32_t feedback_chans[Q6AFE_MAX_FEEDBACK_CHANNELS];
+	int num_feedback_chans;
 };
 
 struct q6afe_dai_data {
@@ -32,8 +40,102 @@
 	struct q6afe_port_config port_config[AFE_PORT_MAX];
 	bool is_port_started[AFE_PORT_MAX];
 	struct q6afe_dai_priv_data priv[AFE_PORT_MAX];
+	u32 *custom_topologies;
+	int custom_topologies_size;
+	bool custom_topologies_registered;
 };
 
+/*
+ * Custom topologies from the vendor ACDB, registered with the DSP before
+ * the first port that uses one starts.
+ */
+static void q6afe_dai_register_topologies(struct device *dev,
+					  struct q6afe_dai_data *dai_data)
+{
+	int ret;
+
+	if (!dai_data->custom_topologies || dai_data->custom_topologies_registered)
+		return;
+
+	ret = q6core_register_topologies(dai_data->custom_topologies,
+					 dai_data->custom_topologies_size);
+	if (ret) {
+		dev_err(dev, "failed to register custom topologies (%d)\n", ret);
+		return;
+	}
+	dai_data->custom_topologies_registered = true;
+}
+
+/*
+ * Run the feedback TX port of an RX port, the way the vendor stacks do with
+ * a hostless capture: feedback path set, RX started, then TX started with
+ * the RX port's I2S format. Failures only cost the feedback, never playback.
+ */
+static void q6afe_dai_feedback_set_path(struct device *dev,
+					struct q6afe_dai_data *dai_data, int rx_id)
+{
+	struct q6afe_dai_priv_data *rx_priv = &dai_data->priv[rx_id];
+	int tx_id = rx_priv->feedback_dai;
+	struct q6afe_port *tx;
+	int ret;
+
+	if (!dai_data->port[tx_id]) {
+		tx = q6afe_port_get_from_id(dev, tx_id);
+		if (IS_ERR(tx)) {
+			dev_err(dev, "no feedback port %d\n", tx_id);
+			rx_priv->feedback_dai = -1;
+			return;
+		}
+		dai_data->port[tx_id] = tx;
+		q6afe_port_set_topology(tx, dai_data->priv[tx_id].topology);
+	}
+
+	ret = q6afe_port_set_feedback_path(dai_data->port[tx_id],
+					   dai_data->port[rx_id],
+					   rx_priv->feedback_chans,
+					   rx_priv->num_feedback_chans);
+	if (ret)
+		dev_err(dev, "failed to set feedback path %d -> %d (%d)\n",
+			tx_id, rx_id, ret);
+}
+
+static void q6afe_dai_feedback_start(struct device *dev,
+				     struct q6afe_dai_data *dai_data, int rx_id)
+{
+	int tx_id = dai_data->priv[rx_id].feedback_dai;
+	struct q6afe_i2s_cfg *cfg = &dai_data->port_config[tx_id].i2s_cfg;
+	int ret;
+
+	if (dai_data->is_port_started[tx_id])
+		return;
+
+	*cfg = dai_data->port_config[rx_id].i2s_cfg;
+	cfg->sd_line_mask = dai_data->priv[tx_id].sd_line_mask;
+
+	ret = q6afe_i2s_port_prepare(dai_data->port[tx_id], cfg);
+	if (!ret)
+		ret = q6afe_port_start(dai_data->port[tx_id]);
+	if (ret) {
+		dev_err(dev, "failed to start feedback port %d (%d)\n",
+			tx_id, ret);
+		return;
+	}
+	dai_data->is_port_started[tx_id] = true;
+}
+
+static void q6afe_dai_feedback_stop(struct device *dev,
+				    struct q6afe_dai_data *dai_data, int rx_id)
+{
+	int tx_id = dai_data->priv[rx_id].feedback_dai;
+
+	if (!dai_data->is_port_started[tx_id])
+		return;
+
+	if (q6afe_port_stop(dai_data->port[tx_id]) < 0)
+		dev_err(dev, "fail to close feedback port %d\n", tx_id);
+	dai_data->is_port_started[tx_id] = false;
+}
+
