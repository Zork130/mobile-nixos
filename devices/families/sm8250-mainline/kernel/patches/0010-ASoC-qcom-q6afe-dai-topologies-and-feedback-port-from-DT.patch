 	u32 hdmi_cfg_minor_version;
 	u16 datatype;
@@ -1315,6 +1327,40 @@
 EXPORT_SYMBOL_GPL(q6afe_port_get_module_param);
 
 /**
+ * q6afe_port_set_feedback_path() - Route a TX port's data to an RX port
+ *
+ * @tx: port carrying the feedback (e.g. speaker amplifier V/I sense)
+ * @rx: port whose processing (e.g. speaker protection) consumes it
+ * @chan_info: channel assignment, as used by the vendor stacks: 1, 2 for the
+ *             first speaker, 3, 4 for the second
+ * @num_channels: number of entries in @chan_info
+ *
+ * Must be set before the TX port is started.
+ *
+ * Return: zero on success, negative error code otherwise.
+ */
+int q6afe_port_set_feedback_path(struct q6afe_port *tx, struct q6afe_port *rx,
+				 const u32 *chan_info, int num_channels)
+{
+	struct afe_param_id_feedback_path_cfg cfg = {
+		.minor_version = AFE_API_VERSION_FEEDBACK_PATH,
+		.dst_portid = rx->id,
+		.num_channels = num_channels,
+	};
+	int i;
+
+	if (num_channels < 1 || num_channels > AFE_FEEDBACK_MAX_CHANNELS)
+		return -EINVAL;
+
+	for (i = 0; i < num_channels; i++)
+		cfg.chan_info[i] = chan_info[i];
+
+	return q6afe_port_set_param_v2(tx, &cfg, AFE_PARAM_ID_FEEDBACK_PATH_CFG,
+				       AFE_MODULE_FEEDBACK, sizeof(cfg));
+}
+EXPORT_SYMBOL_GPL(q6afe_port_set_feedback_path);
+
+/**
  * q6afe_port_set_topology() - Select the topology a port starts with
  *
  * @port: AFE port
@@ -1838,6 +1884,14 @@
 			.topology_id = port->topology,
 		};
 
+		/*
