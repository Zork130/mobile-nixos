@@ -443,6 +557,9 @@
 	}
 	dai_data->is_port_started[dai->id] = true;
 
+	if (dai_data->priv[dai->id].feedback_dai >= 0)
+		q6afe_dai_feedback_start(dai->dev, dai_data, dai->id);
+
 	return 0;
 }
 
@@ -678,6 +795,7 @@
 		return -EINVAL;
 	}
 	dai_data->port[dai->id] = port;
+	q6afe_port_set_topology(port, dai_data->priv[dai->id].topology);
 
 	return 0;
 }
@@ -1027,12 +1145,29 @@
 				    struct q6afe_dai_data *data)
 {
