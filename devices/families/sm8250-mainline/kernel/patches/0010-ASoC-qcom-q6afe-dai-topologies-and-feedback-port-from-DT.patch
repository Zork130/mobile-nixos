+					AFE_PARAM_ID_DEREGISTER_TOPOLOGY,
+					AFE_MODULE_AUDIO_DEV_INTERFACE, 0);
+
 		/* Not fatal: the port still works with the default topology. */
 		if (q6afe_port_set_param_v2(port, &topo,
 					    AFE_PARAM_ID_SET_TOPOLOGY,
diff -ru a/sound/soc/qcom/qdsp6/q6afe-dai.c b/sound/soc/qcom/qdsp6/q6afe-dai.c
