 	for_each_child_of_node(dev->of_node, node) {
 		unsigned int lines[Q6AFE_MAX_MI2S_LINES];
 		struct q6afe_dai_priv_data *priv;
 		int id, i, num_lines;
+		u32 fb;
 
 		ret = of_property_read_u32(node, "reg", &id);
 		if (ret || id < 0 || id >= AFE_PORT_MAX) {
@@ -1040,6 +1175,22 @@
 			continue;
 		}
 
+		priv = &data->priv[id];
+		of_property_read_u32(node, "qcom,topology", &priv->topology);
+		if (!of_property_read_u32(node, "qcom,feedback-dai", &fb) &&
+		    fb < AFE_PORT_MAX && fb != id) {
+			ret = of_property_read_variable_u32_array(node,
+					"qcom,feedback-channels",
+					priv->feedback_chans, 1,
+					Q6AFE_MAX_FEEDBACK_CHANNELS);
+			if (ret > 0) {
+				priv->feedback_dai = fb;
+				priv->num_feedback_chans = ret;
+			} else {
+				dev_err(dev, "dai %d: bad qcom,feedback-channels\n", id);
+			}
+		}
+
 		switch (id) {
 		/* MI2S specific properties */
 		case SENARY_MI2S_RX ... SENARY_MI2S_TX:
