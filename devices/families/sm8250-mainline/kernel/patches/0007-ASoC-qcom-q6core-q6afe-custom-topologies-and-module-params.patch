+/**
+ * q6core_register_topologies() - Register custom topologies with the DSP
+ *
+ * @buf: topology buffer, as stored in the ACDB: a u32 topology count
+ *       followed by the topology definitions
+ * @size: size of @buf in bytes
+ *
+ * The buffer is passed in-band (NULL memory map handle).
+ *
+ * Return: zero on success, negative error code otherwise.
+ */
+int q6core_register_topologies(const void *buf, size_t size)
+{
+	struct avcs_cmd_register_topologies *reg;
+	struct apr_pkt *pkt;
+	int pkt_size, rc;
+
+	if (!g_core)
+		return -ENODEV;
+
+	pkt_size = APR_HDR_SIZE + sizeof(*reg) + size;
+	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	reg = p + APR_HDR_SIZE;
+	memcpy(p + APR_HDR_SIZE + sizeof(*reg), buf, size);
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+				      APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.opcode = AVCS_CMD_REGISTER_TOPOLOGIES;
+	reg->payload_size = size;
+
+	mutex_lock(&g_core->lock);
+	g_core->resp_received = false;
+	g_core->reg_topo_status = 0;
+
+	rc = apr_send_pkt(g_core->adev, pkt);
+	if (rc < 0)
+		goto out;
+
+	rc = wait_event_timeout(g_core->wait, g_core->resp_received,
+				msecs_to_jiffies(Q6_REG_TOPO_TIMEOUT_MS));
+	if (!rc) {
+		rc = -ETIMEDOUT;
+		goto out;
+	}
+	g_core->resp_received = false;
+
+	if (g_core->reg_topo_status) {
+		dev_err(&g_core->adev->dev,
+			"register topologies failed: DSP error 0x%x\n",
+			g_core->reg_topo_status);
+		rc = -EIO;
+	} else {
+		rc = 0;
+	}
+out:
+	mutex_unlock(&g_core->lock);
+	return rc;
+}
+EXPORT_SYMBOL_GPL(q6core_register_topologies);
+
 static int q6core_probe(struct apr_device *adev)
 {
 	g_core = kzalloc_obj(*g_core);
