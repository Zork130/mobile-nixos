+static int q6afe_port_get_param_v2(struct q6afe_port *port, u32 module_id,
+				   u32 param_id, void *data, size_t size)
+{
+	struct afe_port_cmd_get_param_v2 *param;
+	struct q6afe *afe = port->afe;
+	struct apr_pkt *pkt;
+	int ret, pkt_size = APR_HDR_SIZE + sizeof(*param);
+
+	if (size > U16_MAX - sizeof(param->param_hdr))
+		return -EINVAL;
+
+	void *p __free(kfree) = kzalloc(pkt_size, GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+
+	pkt = p;
+	param = p + APR_HDR_SIZE;
+
+	pkt->hdr.hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+					   APR_HDR_LEN(APR_HDR_SIZE),
+					   APR_PKT_VER);
+	pkt->hdr.pkt_size = pkt_size;
+	pkt->hdr.token = port->token;
+	pkt->hdr.opcode = AFE_PORT_CMD_GET_PARAM_V2;
+
+	param->port_id = port->id;
+	param->payload_size = sizeof(param->param_hdr) + size;
+	param->module_id = module_id;
+	param->param_id = param_id;
+	param->param_hdr.module_id = module_id;
+	param->param_hdr.param_id = param_id;
+	param->param_hdr.param_size = size;
+
+	port->get_buf = data;
+	port->get_size = size;
+	ret = afe_apr_send_pkt(afe, pkt, port, AFE_PORT_CMDRSP_GET_PARAM_V2);
+	port->get_buf = NULL;
+	port->get_size = 0;
+	if (ret)
+		dev_err(afe->dev, "AFE get param 0x%x/0x%x on port 0x%x failed %d\n",
+			module_id, param_id, port->id, ret);
+
+	return ret;
+}
+
+/**
+ * q6afe_port_set_module_param() - Set a parameter of a module on a port
+ *
+ * @port: AFE port
+ * @module_id: module in the port's topology
+ * @param_id: parameter of that module
+ * @data: parameter payload
+ * @size: payload size in bytes
+ *
+ * Return: zero on success, negative error code otherwise.
+ */
+int q6afe_port_set_module_param(struct q6afe_port *port, u32 module_id,
+				u32 param_id, const void *data, size_t size)
+{
+	return q6afe_port_set_param_v2(port, (void *)data, param_id,
+				       module_id, size);
+}
+EXPORT_SYMBOL_GPL(q6afe_port_set_module_param);
+
+/**
+ * q6afe_port_get_module_param() - Read a parameter of a module on a port
+ *
+ * @port: AFE port
+ * @module_id: module in the port's topology
+ * @param_id: parameter of that module
+ * @data: buffer for the parameter payload
+ * @size: size of @data in bytes
+ *
+ * Return: zero on success, negative error code otherwise.
+ */
+int q6afe_port_get_module_param(struct q6afe_port *port, u32 module_id,
+				u32 param_id, void *data, size_t size)
+{
+	return q6afe_port_get_param_v2(port, module_id, param_id, data, size);
+}
+EXPORT_SYMBOL_GPL(q6afe_port_get_module_param);
+
+/**
+ * q6afe_port_set_topology() - Select the topology a port starts with
+ *
+ * @port: AFE port
+ * @topology_id: topology id, or 0 for the DSP default. Custom topologies
+ *               must be registered first, see q6core_register_topologies().
+ *
+ * Takes effect on the next q6afe_port_start().
+ */
+void q6afe_port_set_topology(struct q6afe_port *port, u32 topology_id)
+{
+	port->topology = topology_id;
+}
+EXPORT_SYMBOL_GPL(q6afe_port_set_topology);
+
