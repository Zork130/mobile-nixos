+#ifdef CONFIG_DEBUG_FS
+/*
+ * Raw access to DSP modules, for bringing up vendor modules such as speaker
+ * protection. Numbers are parsed with base 0, payloads are u32 words.
+ *
+ *   regtopo <word>...                      register custom topologies
+ *   topo <port> <topology>                 topology for the port's next start
+ *   set <port> <module> <param> <word>...  set a module parameter
+ *   get <port> <module> <param> <bytes>    get a module parameter
+ *
+ * <port> is the DSP port id (e.g. 0x1004 for TERTIARY_MI2S_RX). Reading
+ * the file returns the result of the last command.
+ */
+#define Q6AFE_DBG_MAX_WORDS 256
+
+static struct q6afe_port *q6afe_find_port_by_id(struct q6afe *afe, u32 id)
+{
+	struct q6afe_port *p;
+
+	guard(spinlock_irqsave)(&afe->port_list_lock);
+	list_for_each_entry(p, &afe->port_list, node)
+		if (p->id == id) {
+			kref_get(&p->refcount);
+			return p;
+		}
+
+	return NULL;
+}
+
+static void q6afe_dbg_printf(struct q6afe *afe, const char *fmt, ...)
+{
+	va_list args;
+
+	va_start(args, fmt);
+	afe->dbg_len += vscnprintf(afe->dbg_out + afe->dbg_len,
+				   sizeof(afe->dbg_out) - afe->dbg_len,
+				   fmt, args);
+	va_end(args);
+}
+
+static int q6afe_dbg_run(struct q6afe *afe, char *line)
+{
+	struct q6afe_port *port = NULL;
+	char *cmd, *tok;
+	u32 *w;
+	int n = 0, ret, i;
+
+	w = kcalloc(Q6AFE_DBG_MAX_WORDS, sizeof(*w), GFP_KERNEL);
+	if (!w)
+		return -ENOMEM;
+
+	cmd = strsep(&line, " \t\n");
+	while ((tok = strsep(&line, " \t\n"))) {
+		if (!*tok)
+			continue;
+		if (n == Q6AFE_DBG_MAX_WORDS) {
+			ret = -E2BIG;
+			goto out;
+		}
+		ret = kstrtou32(tok, 0, &w[n++]);
+		if (ret)
+			goto out;
+	}
+
+	if (!strcmp(cmd, "regtopo")) {
+		ret = q6core_register_topologies(w, n * sizeof(*w));
+		goto out;
+	}
+
+	ret = -EINVAL;
+	if (n < 2)
+		goto out;
+	port = q6afe_find_port_by_id(afe, w[0]);
+	if (!port) {
+		ret = -ENODEV;
+		goto out;
+	}
+
+	if (!strcmp(cmd, "topo") && n == 2) {
+		q6afe_port_set_topology(port, w[1]);
+		ret = 0;
+	} else if (!strcmp(cmd, "set") && n >= 3) {
+		ret = q6afe_port_set_module_param(port, w[1], w[2], &w[3],
+						  (n - 3) * sizeof(*w));
+	} else if (!strcmp(cmd, "get") && n == 4) {
+		size_t size = min_t(size_t, round_up(w[3], 4),
+				    Q6AFE_DBG_MAX_WORDS * sizeof(*w));
+		u32 *buf = kzalloc(size, GFP_KERNEL);
+
+		if (!buf) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		ret = q6afe_port_get_module_param(port, w[1], w[2], buf, size);
+		q6afe_dbg_printf(afe, "%s %d dsp_status 0x%x\n", cmd, ret,
+				 port->result.status);
+		for (i = 0; !ret && i < size / 4; i++)
+			q6afe_dbg_printf(afe, "%08x%c", buf[i],
+					 (i % 8 == 7) ? '\n' : ' ');
+		q6afe_dbg_printf(afe, "\n");
+		kfree(buf);
+		goto out_put;
+	}
+	q6afe_dbg_printf(afe, "%s %d dsp_status 0x%x\n", cmd, ret,
+			 port->result.status);
+out_put:
+	q6afe_port_put(port);
+	kfree(w);
+	return ret;
+out:
+	q6afe_dbg_printf(afe, "%s %d\n", cmd ? cmd : "", ret);
+	kfree(w);
+	return ret;
+}
+
+static ssize_t q6afe_dbg_write(struct file *file, const char __user *ubuf,
+			       size_t count, loff_t *ppos)
+{
+	struct q6afe *afe = file->private_data;
+	char *line;
+
+	if (count > 4096)
+		return -E2BIG;
+
+	line = memdup_user_nul(ubuf, count);
+	if (IS_ERR(line))
+		return PTR_ERR(line);
+
+	mutex_lock(&afe->dbg_lock);
+	afe->dbg_len = 0;
+	q6afe_dbg_run(afe, line);
+	mutex_unlock(&afe->dbg_lock);
+	kfree(line);
+
+	return count;
+}
+
+static ssize_t q6afe_dbg_read(struct file *file, char __user *ubuf,
+			      size_t count, loff_t *ppos)
+{
+	struct q6afe *afe = file->private_data;
+	ssize_t ret;
+
+	mutex_lock(&afe->dbg_lock);
+	ret = simple_read_from_buffer(ubuf, count, ppos, afe->dbg_out,
+				      afe->dbg_len);
+	mutex_unlock(&afe->dbg_lock);
+
+	return ret;
+}
+
+static const struct file_operations q6afe_dbg_fops = {
+	.open = simple_open,
+	.read = q6afe_dbg_read,
+	.write = q6afe_dbg_write,
+	.llseek = default_llseek,
+};
+
+static void q6afe_debugfs_remove(void *data)
+{
+	struct q6afe *afe = data;
+
+	debugfs_remove_recursive(afe->debugfs);
+}
+
+static void q6afe_debugfs_init(struct q6afe *afe)
+{
+	mutex_init(&afe->dbg_lock);
+	afe->debugfs = debugfs_create_dir("q6afe", NULL);
+	debugfs_create_file("cmd", 0600, afe->debugfs, afe, &q6afe_dbg_fops);
+	devm_add_action_or_reset(afe->dev, q6afe_debugfs_remove, afe);
+}
+#else
+static void q6afe_debugfs_init(struct q6afe *afe) {}
+#endif
+
 static int q6afe_probe(struct apr_device *adev)
 {
 	struct q6afe *afe;
@@ -1922,6 +2272,7 @@
 	spin_lock_init(&afe->port_list_lock);
 
 	dev_set_drvdata(dev, afe);
+	q6afe_debugfs_init(afe);
 
 	return devm_of_platform_populate(dev);
 }
