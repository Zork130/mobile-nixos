From: Zork130 <12914881+Zork130@users.noreply.github.com>
Subject: [PATCH] ASoC: sm8250/tfa987x: 2 x 32 bit slots on the OnePlus 8 Pro
 speaker interface

With 16 bit slots the amplifiers' current sense comes back with only a few
LSBs of signal at normal levels, too coarse for speaker protection. Run the
tertiary MI2S like the vendor kernel: 64 BCKs per frame (3.072 MHz), S24 in
32 bit slots, and the amplifiers set up for 32 bit slots and samples.

diff -ru a/sound/soc/codecs/tfa987x.c b/sound/soc/codecs/tfa987x.c
--- a/sound/soc/codecs/tfa987x.c	2026-11-02 15:46:07.184779152 +0000
+++ b/sound/soc/codecs/tfa987x.c	2026-11-02 15:46:21.291328456 +0000
@@ -134,7 +134,8 @@
 	.name = "tfa987x-hifi",
 	.playback = {
 		.stream_name	= "HiFi Playback",
-		.formats	= SNDRV_PCM_FMTBIT_S16_LE,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE |
+				  SNDRV_PCM_FMTBIT_S24_LE,
 		.rates		= SNDRV_PCM_RATE_48000,
 		.rate_min	= 48000,
 		.rate_max	= 48000,
@@ -144,7 +145,8 @@
 	/* Current sense, see TDMCSE */
 	.capture = {
 		.stream_name	= "HiFi Capture",
-		.formats	= SNDRV_PCM_FMTBIT_S16_LE,
+		.formats	= SNDRV_PCM_FMTBIT_S16_LE |
+				  SNDRV_PCM_FMTBIT_S24_LE,
 		.rates		= SNDRV_PCM_RATE_48000,
 		.rate_min	= 48000,
 		.rate_max	= 48000,
@@ -317,18 +319,21 @@
 	regmap_update_bits(rmap, TFA987X_AUDIO_CTRL,
 				 TFA987X_AUDIO_CTRL_DPSA_MSK, 0);
 
-	/* Setup TDM 16 bit 1 slot config */
+	/*
+	 * I2S, 2 slots of 32 bits (64 BCKs per frame), as in the vendor
+	 * tfa98xx.cnt: the current sense needs the resolution.
+	 */
 	regmap_update_bits(rmap, TFA987X_TDM_CFG0,
 				 TFA987X_TDM_CFG0_FSBCLKS_MSK,
-				 FIELD_PREP(TFA987X_TDM_CFG0_FSBCLKS_MSK, 0));
+				 FIELD_PREP(TFA987X_TDM_CFG0_FSBCLKS_MSK, 2));
 	regmap_update_bits(rmap, TFA987X_TDM_CFG1,
 				 TFA987X_TDM_CFG1_NSLOTS_MSK |
 				 TFA987X_TDM_CFG1_SLOTBITS_MSK,
 				 FIELD_PREP(TFA987X_TDM_CFG1_NSLOTS_MSK, 1) |
-				 FIELD_PREP(TFA987X_TDM_CFG1_SLOTBITS_MSK, 15));
+				 FIELD_PREP(TFA987X_TDM_CFG1_SLOTBITS_MSK, 31));
 	regmap_update_bits(rmap, TFA987X_TDM_CFG2,
 				 TFA987X_TDM_CFG2_SWIDTH_MSK,
-				 FIELD_PREP(TFA987X_TDM_CFG2_SWIDTH_MSK, 15));
+				 FIELD_PREP(TFA987X_TDM_CFG2_SWIDTH_MSK, 31));
 
 	/*
 	 * Current sense out on DATAO, in this amplifier's slot, as feedback
diff -ru a/sound/soc/qcom/sm8250.c b/sound/soc/qcom/sm8250.c
--- a/sound/soc/qcom/sm8250.c	2026-11-02 15:46:07.183779112 +0000
+++ b/sound/soc/qcom/sm8250.c	2026-11-02 15:46:43.311187486 +0000
@@ -17,6 +17,8 @@
 #include "sdw.h"
 
 #define MI2S_BCLK_RATE		1536000
+/* Speaker amplifiers: 2 x 32 bit slots, for their current sense feedback */
+#define TER_MI2S_BCLK_RATE	3072000
 #define TDM_BCLK_RATE		12288000
 
 static unsigned int tdm_slot_offset[8] = {0, 4, 8, 12, 16, 20, 24, 28};
@@ -117,10 +119,20 @@
 	struct snd_interval *channels = hw_param_interval(params,
 					SNDRV_PCM_HW_PARAM_CHANNELS);
 	struct snd_mask *fmt = hw_param_mask(params, SNDRV_PCM_HW_PARAM_FORMAT);
+	struct snd_soc_dai *cpu_dai = snd_soc_rtd_to_cpu(rtd, 0);
 
 	rate->min = rate->max = 48000;
 	channels->min = channels->max = 2;
-	snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+	switch (cpu_dai->id) {
+	case TERTIARY_MI2S_RX:
+	case TERTIARY_MI2S_TX:
+		snd_mask_none(fmt);
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S24_LE);
+		break;
+	default:
+		snd_mask_set_format(fmt, SNDRV_PCM_FORMAT_S16_LE);
+		break;
+	}
 
 	return 0;
 }
@@ -156,7 +168,7 @@
 		codec_dai_fmt |= SND_SOC_DAIFMT_NB_NF | SND_SOC_DAIFMT_I2S;
 		snd_soc_dai_set_sysclk(cpu_dai,
 			Q6AFE_LPASS_CLK_ID_TER_MI2S_IBIT,
-			MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
+			TER_MI2S_BCLK_RATE, SNDRV_PCM_STREAM_PLAYBACK);
 		snd_soc_dai_set_fmt(cpu_dai, fmt);
 		snd_soc_dai_set_fmt(codec_dai, codec_dai_fmt);
 		break;
